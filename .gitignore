# Plan task files & documentation (only persist directory structure via .gitkeep)
docs/plan/**/*.md
docs/plan/*.md
!docs/plan/**/.gitkeep
# The plan 3 model-preparation package is a committed planning deliverable.
!docs/plan/3/
!docs/plan/3/*.md
!docs/plan/3/workstream/
