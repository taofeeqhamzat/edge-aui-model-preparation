clipboard*.md
instructions*.md
# Stray session artifact: a literal filename created when a shell quoted a `:memory:` DSN
# incorrectly. Not project data, but it keeps reappearing from ad-hoc commands.
:memory:*

# Scripted-run browser downloads (export button artefacts); traces are the record, not these files
.data/raw/scripted/.downloads/

# uv cache (local, not project data)
.uv-cache/

# Local QA/coverage artifacts (code-qna tools write these)
.coverage
coverage.xml
coverage.json
.metrics/
target/
